table 'dw vw_gasto_por_modalidad'
	lineageTag: a145e57f-3866-4968-a0bc-2c22c7a98fb9

	measure 'Monto total (mil millones)' = DIVIDE(SUM('dw vw_gasto_por_modalidad'[monto_clp]), 1000000000)
		formatString: #,0
		lineageTag: d098825b-79df-43a1-bb64-4f2b1e3d5e9b

	measure 'N° de órdenes' = SUM('dw vw_gasto_por_modalidad'[n_oc])
		formatString: #,0
		lineageTag: a16978a2-6740-426d-83a0-72d2053c97ec

	measure '% monto Trato Directo' = DIVIDE(CALCULATE(SUM('dw vw_gasto_por_modalidad'[monto_clp]), 'dw vw_gasto_por_modalidad'[modalidad] = "Trato Directo"), SUM('dw vw_gasto_por_modalidad'[monto_clp]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 01992fce-ed28-403e-83ed-16f3e0101751

	measure '% de las órdenes' = DIVIDE(SUM('dw vw_gasto_por_modalidad'[n_oc]), CALCULATE(SUM('dw vw_gasto_por_modalidad'[n_oc]), ALL('dw vw_gasto_por_modalidad'[modalidad])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7d3f80c5-8e15-457b-80ca-ccf337baef7b

	measure '% del monto' = DIVIDE(SUM('dw vw_gasto_por_modalidad'[monto_clp]), CALCULATE(SUM('dw vw_gasto_por_modalidad'[monto_clp]), ALL('dw vw_gasto_por_modalidad'[modalidad])))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 82520025-b350-4aef-a620-95f9605faea8

